{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "company": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Company"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_url": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Source Url"
    },
    "speaker": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Speaker"
    },
    "title": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Title"
    },
    "transcript_path": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Transcript Path",
      "type": "string"
    },
    "transcript_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transcript Sha256",
      "type": "string"
    },
    "version": {
      "default": "1",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Version",
      "type": "string"
    },
    "youtube_video_id": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Youtube Video Id"
    }
  },
  "required": [
    "id",
    "title",
    "speaker",
    "source_url",
    "transcript_path",
    "transcript_sha256"
  ],
  "title": "Talk",
  "type": "object"
}
